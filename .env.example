# 开发与 Docker Compose 共用此模板：cp .env.example .env
# .env 包含敏感配置，不要提交。登录、通知和审计策略在网页系统设置中管理。

# 必填：openssl rand -hex 32 生成；首次启动后固定保存并备份。
ENCRYPTION_KEY=
# 开发使用 Vite 地址；生产必须改为用户实际访问的 HTTPS 来源，不含路径。
PUBLIC_URL=http://127.0.0.1:9527

# 本地开发：make dev 读取 DATABASE_URL；先准备 PostgreSQL，启动示例见 docs/03-LocalDevelopment.md。
# 生产 Compose 自动生成内置 PostgreSQL 连接，不读取这里的 DATABASE_URL。
DATABASE_URL=postgres://access_gateway:access_gateway@localhost:5432/access_gateway?sslmode=disable
# 如需修改开发数据库，同时修改 DATABASE_URL 中对应的用户名、密码、库名或端口。
# HTTP_ADDR=127.0.0.1:8080
# DEV_WEB_PORT=9527

# 生产 Compose：填写实际发布镜像版本或 digest、数据库密码及 Docker socket 组号。
# 镜像示例：kuzane/access-gateway@sha256:...
ACCESS_GATEWAY_IMAGE=
POSTGRES_PASSWORD=
# 在 Linux 主机执行 stat -Lc '%g' /var/run/docker.sock 获取组号。
DOCKER_SOCKET_GID=
ACCESS_GATEWAY_SECRETS_HOST_PATH=/secure/control-secrets
SESSION_AGENT_STATE_HOST_PATH=/srv/access-gateway/sessions
# 默认数据目录相对于 Compose 文件；私有网段应避开现有路由。
# POSTGRES_DB=access_gateway
# POSTGRES_USER=access_gateway
# POSTGRES_DATA_HOST_PATH=./data/postgres
# POSTGRES_NETWORK_PREFIX=172.29.0
# ACCESS_GATEWAY_API_PORT=8080
# DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock

# 首次初始化管理员；密码默认自动生成，不会在重启时重置。
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_NICKNAME=Administrator
# 开发可自定义初始密码文件；生产固定保存在 ACCESS_GATEWAY_SECRETS_HOST_PATH 下。
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/absolute/private/initial-admin-password

# 演示模式：开启后访问申请自动审批，会话时长固定为 5 分钟；默认关闭。
# 目标账号和数据库预填 test（Redis 库编号仍为 0）；默认密码由服务端加密下发，均可编辑。
# DEMO_MODE=true

# 可选会话限制；未设置时使用下列默认值，最长会话不得超过 5h。
# 演示模式下会话 TTL 固定为 5 分钟。
# SESSION_DEFAULT_TTL=1h
# SESSION_MAX_TTL=5h
# SESSION_AGENT_PORT_START=20000
# SESSION_AGENT_PORT_END=20999
# SESSION_AGENT_MAX_SESSIONS=100
# SESSION_AGENT_STARTUP_TIMEOUT=90s
# 开发自动使用 local，生产 Compose 自动使用 docker；Kubernetes 使用 deploy/ 清单。
# 会话 Agent 由控制面生成配置并启动，无需单独的环境变量文件。
# SESSION_AGENT_BINARY=/absolute/path/to/gateway-agent
# SESSION_AGENT_STATE_DIR=/absolute/private/session-agents

# 开发身份请求头默认关闭，生产必须保持关闭。
# ALLOW_DEV_AUTH=false
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=10

# 可选：直接运行 Go 命令时可用 NAME_FILE 代替敏感值，二者不能同时设置。
# 生产 Compose 已自动使用凭据文件；不要手动覆盖其运行时文件路径。
# ENCRYPTION_KEY_FILE=/absolute/private/encryption-key
# DATABASE_URL_FILE=/absolute/private/database-url
# METRICS_BEARER_TOKEN_FILE=/absolute/private/metrics-bearer-token
# AUDIT_COLLECTOR_SECRET_FILE=/absolute/private/audit-collector-secret
# 独立资产密钥仅在需要时配置，文件与 ID 必须同时提供。
# ASSET_ENCRYPTION_KEY_FILE=/absolute/private/asset-encryption-key
# ASSET_ENCRYPTION_KEY_ID=asset-master-v1

# 可选外部 CMDB 与追踪。
# CMDB_URL=https://cmdb.example.com/api/v1/assets
# CMDB_SOURCE=primary-cmdb
# CMDB_BEARER_TOKEN_FILE=/absolute/private/cmdb-bearer-token
# CMDB_SYNC_INTERVAL=5m
# OTEL_SERVICE_NAME=access-gateway
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
